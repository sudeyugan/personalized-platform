{
  "manifest_version": 3,
  "name": "一隅 · 可信登录点击（可选组件）",
  "version": "0.1.0",
  "description": "仅在你连接一隅只读扩展后，为已授权登录任务短暂派发可信点击；不读取密码、Cookie、网络或页面正文。调试权限本身较强，请知情安装。",
  "key": "",
  "permissions": ["storage", "debugger"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "connect.html" },
  "externally_connectable": { "ids": ["*"] },
  "web_accessible_resources": [{ "resources": ["connect.html"], "extension_ids": ["*"] }],
  "incognito": "not_allowed",
  "minimum_chrome_version": "120"
}
